# ==============================================================================
# Auditgo — AI-Powered SEO Audit & Intelligence Platform Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud API Credentials (Required for Grounded Q&A and Fix Refinements)
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Groq Model Configuration (Optional - Auto-detected if not specified)
# ------------------------------------------------------------------------------
# Fast model for quick conversational streaming and real-time replies
# Recommended: openai/gpt-oss-20b, qwen/qwen3.8-27b, llama-3.1-8b-instant
GROQ_QUICK_MODEL=openai/gpt-oss-20b

# High-capability model for in-depth technical audits and multi-page synthesis
# Recommended: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b
GROQ_DEEP_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 4. Crawler Defaults (Optional)
# ------------------------------------------------------------------------------
MAX_CRAWL_PAGES=150
CRAWL_MAX_DEPTH=4
CRAWL_TIMEOUT_SECONDS=120
